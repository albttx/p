# p shell integration for bash. Add to ~/.bashrc, in this order:
#   eval "$(p init bash)"          # 1. this cd wrapper
#   source <(p completion bash)    # 2. tab completion, needs the wrapper
p() {
  local out
  out="$(command p "$@")" || return $?
  case "$out" in
    __P_CD__*) builtin cd -- "${out#__P_CD__}" ;;
    __P_TMUX__*)
      local session="${out#__P_TMUX__}"
      if [ -n "$session" ]; then
        command tmux attach -t="$session"
      else
        command tmux attach
      fi
      return $? ;;
    *) [ -n "$out" ] && printf '%s\n' "$out" ;;
  esac
  return 0
}
