# p shell integration for fish. Add to config.fish, in this order:
#   p init fish | source          # 1. this cd wrapper
#   p completion fish | source    # 2. tab completion, needs the wrapper
function p --description 'jump to a project'
    set -l out (command p $argv | string collect)
    set -l code $pipestatus[1]
    if test $code -ne 0
        return $code
    end
    if test -z "$out"
        return 0
    end
    if string match -q -- '__P_CD__*' "$out"
        set -l dir (string replace -- '__P_CD__' '' "$out")
        builtin cd $dir
        return $status
    end
    if string match -q -- '__P_TMUX__*' "$out"
        set -l session (string replace -- '__P_TMUX__' '' "$out")
        if test -n "$session"
            command tmux attach -t="$session"
        else
            command tmux attach
        end
        return $status
    end
    printf '%s\n' "$out"
    return 0
end
