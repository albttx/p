# p shell integration for fish. Add to config.fish, in this order:
#   p-bin init fish | source          # 1. this cd wrapper
#   p-bin completion fish | source    # 2. tab completion, needs the wrapper
function p --description 'jump to a project'
    set -l out (command p-bin $argv | string collect)
    set -l code $pipestatus[1]
    if test $code -ne 0
        return $code
    end
    if test -z "$out"
        return 0
    end
    if string match -q -- '__P_CD__*' "$out"
        set -l dir (string replace -- '__P_CD__' '' "$out")
        builtin cd $dir
        return $status
    end
    printf '%s\n' "$out"
    return 0
end
